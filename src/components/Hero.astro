---
const heroImages = Array.from(
  { length: 10 },
  (_, i) => `/images/hero/hero-${String(i + 1).padStart(2, "0")}.webp`,
);

const SLIDE_DURATION = 5;
const TOTAL_DURATION = heroImages.length * SLIDE_DURATION;
const SLIDE_PERCENT = 100 / heroImages.length;
const FADE_PERCENT = SLIDE_PERCENT * 0.3;
const FADE_IN_END = FADE_PERCENT.toFixed(2);
const HOLD_END = SLIDE_PERCENT.toFixed(2);
const FADE_OUT_END = (SLIDE_PERCENT + FADE_PERCENT).toFixed(2);
---

<section class="hero">
  <div class="hero-media">
    <div class="hero-slideshow" aria-hidden="true">
      {
        heroImages.map((src, index) => (
          <img
            src={src}
            alt=""
            class="hero-slide"
            style={`animation-delay: -${index * SLIDE_DURATION}s`}
            loading="eager"
            decoding="async"
          />
        ))
      }
    </div>
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <!-- <p class="hero-tagline">渋谷を代表する店をつくる</p> -->
    <div class="hero-scroll">
      <span class="scroll-text">Scroll</span>
      <span class="scroll-line"></span>
    </div>
  </div>
</section>

<style set:html={`
  @keyframes heroFade {
    0% { opacity: 0; z-index: 0; transform: scale(1); }
    ${FADE_IN_END}% { opacity: 1; z-index: 1; transform: scale(1); }
    ${HOLD_END}% { opacity: 1; z-index: 1; transform: scale(1.06); }
    ${FADE_OUT_END}% { opacity: 0; z-index: 0; transform: scale(1.06); }
    100% { opacity: 0; z-index: 0; transform: scale(1); }
  }
`}></style>

<style define:vars={{ totalDuration: `${TOTAL_DURATION}s` }}>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-slideshow {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    z-index: 0;
    animation: heroFade var(--totalDuration) linear infinite;
    transform: scale(1);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.3) 0%,
      rgba(10, 10, 10, 0.1) 40%,
      rgba(10, 10, 10, 0.5) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    color: var(--color-white);
  }

  .hero-tagline {
    font-family: var(--font-ja);
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
    font-weight: 300;
    letter-spacing: 0.25em;
    line-height: 1.8;
    opacity: 0;
    animation: fadeUp 1s 0.3s var(--ease-out-expo) forwards;
  }

  .hero-scroll {
    position: absolute;
    bottom: -40vh;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .scroll-text {
    font-family: var(--font-en);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 50px;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.5),
      transparent
    );
    animation: scrollDown 1.8s ease-in-out infinite;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scrollDown {
    0% {
      opacity: 0;
      transform: scaleY(0);
      transform-origin: top;
    }
    30% {
      opacity: 1;
      transform: scaleY(1);
      transform-origin: top;
    }
    60% {
      opacity: 1;
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      opacity: 0;
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (max-width: 768px) {
    .hero-tagline {
      letter-spacing: 0.15em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide {
      animation: none;
    }

    .hero-slide:first-child {
      opacity: 1;
      z-index: 1;
    }
  }
</style>
